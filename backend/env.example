# Server Configuration
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bball_tracker?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# WorkOS Authentication
WORKOS_API_KEY="sk_test_..."
WORKOS_CLIENT_ID="client_..."
WORKOS_ENVIRONMENT="sandbox"
WORKOS_REDIRECT_URI="http://localhost:3000/api/v1/auth/callback"
# Expected `iss` claim when verifying access tokens against the WorkOS JWKS (default shown).
WORKOS_JWT_ISSUER="https://api.workos.com"
# Hosts / custom schemes accepted for the `redirect_uri` query param on GET /auth/login
# (comma-separated; defaults: localhost / bball-tracker). Production allows the mobile scheme.
ALLOWED_REDIRECT_HOSTS="localhost"
ALLOWED_REDIRECT_SCHEMES="bball-tracker"
# Emails that get the ADMIN role at FIRST sign-up (comma-separated, case-insensitive).
# Legacy single-value ADMIN_EMAIL is still honoured. Re-login never changes an existing role.
ADMIN_EMAILS=""
# For email/password auth using AuthKit (recommended):
WORKOS_PROVIDER="authkit"
# Alternative options (set ONE of the following if not using authkit):
# WORKOS_CONNECTION_ID=""  # For custom connections (Magic Link, OTP, etc.)
# WORKOS_ORGANIZATION_ID=""  # For organization-based SSO
# Note: If none are set, the code defaults to WORKOS_PROVIDER="authkit"

# AWS (S3 avatar uploads via presigned POST — POST /uploads/avatar-url)
AWS_REGION="us-east-1"
S3_AVATARS_BUCKET="bball-tracker-avatars-dev"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Optional: override the RDS CA bundle path used for TLS to Postgres (default: ./certs/rds-global-bundle.pem)
# RDS_CA_BUNDLE_PATH=""

# SES Email (leave blank in dev/test — falls back to FakeMailer)
AWS_SES_REGION="us-east-1"
SES_FROM_ADDRESS="noreply@mail.hooplings.com"

# Public web app base URL (human-facing links: invite pages, "View game" in emails).
# Production sets https://hooplings.com. Unset → http://localhost:3000 (fail-loud; a
# boot warning is logged in production). See utils/urls.ts.
PUBLIC_APP_URL="http://localhost:3000"
# Host that serves /api/v1/* — used for calendar feed / webcal URLs (audit #24).
# Production sets https://api.hooplings.com. Unset → http://localhost:3000.
API_BASE_URL="http://localhost:3000"
# IANA time zone used to format dates in outbound email (audit #57). Default America/Los_Angeles.
DEFAULT_TIMEZONE="America/Los_Angeles"

# CORS — comma-separated list of exact browser origins (scheme + host, no wildcard) allowed to
# call the API. Native mobile sends no Origin header and is never affected. Production lists
# api + apex + www (infra/task-definition.json) so the web invite page can POST the accept (#447).
# Add your local web dev origin here (e.g. http://localhost:3001) when running web/ locally.
CORS_ORIGIN="http://localhost:19006"

# Socket.io runs on the HTTP server (same PORT). Single replica only — set this once a
# Redis adapter is wired up (issue #26); production refuses to start multi-replica without it.
# REDIS_SOCKET_ADAPTER_URL=""

# Sentry error tracking
# Leave SENTRY_DSN unset in dev — Sentry init no-ops without it.
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
# Populated in CI from git SHA; leave empty locally.
SENTRY_RELEASE=""
# Optional — traces sample rate (default 0.1)
SENTRY_TRACES_SAMPLE_RATE="0.1"
# Only used by the CI sourcemap upload step.
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

