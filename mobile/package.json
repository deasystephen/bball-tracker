{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "i18n:mark": "node scripts/i18n-mark-translated.js",
    "binary-manifest:check": "jest __tests__/binary-manifest.test.ts",
    "binary-manifest:record": "RECORD_BINARY_MANIFEST=1 jest __tests__/binary-manifest.test.ts",
    "ota:production": "node scripts/require-sentry-auth-token.js && npm run binary-manifest:check && eas update --branch production --environment production --platform ios --non-interactive",
    "postota:production": "node node_modules/@sentry/react-native/scripts/has-sourcemap-debugid.js dist/_expo/static/js/ios/*.map && SENTRY_ORG=satsun-ventures SENTRY_PROJECT=bball-tracker-mobile sentry-expo-upload-sourcemaps dist",
    "eas-build-on-success": "node scripts/sentry-set-commits.js"
  },
  "dependencies": {
    "@amplitude/analytics-react-native": "^1.14.0",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/oswald": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@sentry/react-native": "^8.36.0",
    "@tanstack/react-query": "^5.108.4",
    "axios": "^1.21.0",
    "babel-preset-expo": "^58.0.27",
    "expo": "~58.0.26",
    "expo-application": "~58.1.2",
    "expo-blur": "~58.0.6",
    "expo-constants": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-updates": "~58.0.22",
    "i18next": "^26.5.2",
    "qrcode-generator": "^2.0.4",
    "react": "19.3.0",
    "react-i18next": "^17.1.12",
    "react-native": "0.88.1",
    "react-native-confetti-cannon": "^1.5.2",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "socket.io-client": "^4.8.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.1",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.3.0",
    "eas-cli": "^22.6.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "globals": "^17.12.0",
    "jest": "^29.7.0",
    "jest-expo": "^58.0.16",
    "react-test-renderer": "19.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript",
        "expo-modules-core",
        "react-native-worklets",
        "jest",
        "@types/jest",
        "@sentry/react-native"
      ]
    }
  },
  "overrides": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "browserslist": "^4.28.7",
    "diff": "8.0.3",
    "node-forge": "^1.4.3",
    "tar": "^7.5.8",
    "@xmldom/xmldom": "^0.8.12",
    "follow-redirects": "^1.16.2",
    "eas-cli": {
      "minimatch@^5": "^5.1.8"
    },
    "form-data": "^4.0.6",
    "shell-quote": "^1.11.0",
    "undici": "^6.29.1",
    "ws@^8": "^8.21.0",
    "nanoid": "^3.3.18",
    "js-yaml@^4": "^4.3.2",
    "@oclif/core": {
      "minimatch@^10": "^10.2.5"
    },
    "moment": "^2.31.0",
    "joi": "^17.13.8",
    "expo-router": {
      "@testing-library/react-native": "^13.3.3"
    },
    "react-dom": "19.3.0"
  },
  "private": true
}
