# Copy this file to terraform.tfvars and fill in your values
# Do NOT commit terraform.tfvars to version control

aws_region  = "us-east-1"
environment = "staging"

# Database credentials
db_username = "bball_admin"
db_password = "CHANGE_ME_TO_A_STRONG_PASSWORD"

# Application secrets
jwt_secret     = "CHANGE_ME_TO_A_RANDOM_SECRET"
workos_api_key = ""
workos_client_id = ""

# Domains (zones, ACM certificates and SES identities are managed in dns.tf / ses.tf).
# Every key gets a hosted zone; `serve = true` also provisions the API certificate,
# api.<domain> record and mail identity. Flip serve to false to retire a domain.
domains = {
  "hooplings.com" = { serve = true }
  "capyhoops.com" = { serve = false } # zone only — retired 2026-09-07
}
primary_domain = "hooplings.com"

# NOTE: application env vars (ADMIN_EMAILS, SENTRY_*, SES_*, ...) are NOT set here.
# They live in infra/task-definition.json, which CI deploys. See infra/README.md.
