# Terraform state files - contain sensitive data
*.tfstate
*.tfstate.backup
.terraform/
# .terraform.lock.hcl is COMMITTED: it pins the provider every apply uses, and
# Dependabot's terraform ecosystem bumps it (#786).

# Variable files with secrets
terraform.tfvars
*.tfvars.json
*.auto.tfvars

# Crash logs
crash.log
crash.*.log

# Plan output files
*.tfplan
